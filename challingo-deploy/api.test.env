# Challingo API - build, ports, and runtime settings (appsettings.json via env vars)
# Run sync-server-env.ps1 after edits to update server-files/.env for the VPS.

# --- Build (dev machine) ---
TAG=1.0.0
REGISTRY=host.docker.internal:5000

# --- Host ports on VPS (change if another project uses the same ports) ---
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5434

# --- Postgres ---
POSTGRES_USER=scaffoldadmin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=testapp

# --- ASP.NET Core (double underscore = nested appsettings) ---
ConnectionStrings__Database=Host=postgres;Port=5432;Database=testapp;Username=scaffoldadmin;Password=changeme;Pooling=true
Jwt__Key=change-me-use-at-least-32-characters-long-secret
Jwt__Issuer=Challingo
Jwt__Audience=Challingo-Users
Jwt__ExpirationInMinutes=30
Jwt__RefreshTokenExpirationDays=7

Cors__AllowedOrigins__0=http://127.0.0.1:3000
Cors__AllowedOrigins__1=http://localhost:3000

Store__Currency=USD
Store__FreeShippingThreshold=150
Store__FlatShippingRate=7

Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=
Stripe__SuccessUrl=http://127.0.0.1:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
Stripe__CancelUrl=http://127.0.0.1:3000/cart

# --- OTP / sms.ir (edit before publish) ---
# Dev: Otp__DevMode=true, Otp__LogOnly=true, Sms__Provider=LogOnly
# Production: Otp__DevMode=false, Otp__LogOnly=false, Sms__Provider=SmsIr, set key + template id
Otp__DevMode=true
Otp__LogOnly=true
Sms__Provider=LogOnly
Sms__SmsIrApiKey=
Sms__SmsIrVerifyTemplateId=
Sms__SmsIrVerifyCodeParameterName=CODE
# Sms__SmsIrLineNumber=
# Sms__OtpMessageTemplate=کد ورود Challingo: {code}
