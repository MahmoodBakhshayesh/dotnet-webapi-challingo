# Kestrel (dotnet run / GUI Local Dev) — default port 5128
NEXT_PUBLIC_API_URL=http://127.0.0.1:5128
NEXT_PUBLIC_WS_URL=http://127.0.0.1:5128

# IIS Express (Visual Studio) — HTTPS sslPort 44390
# NEXT_PUBLIC_API_URL=https://localhost:44390
# NEXT_PUBLIC_WS_URL=https://localhost:44390