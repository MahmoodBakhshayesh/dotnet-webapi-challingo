# Local dev - copy to .env (gitignored). Used by DotNetEnv in Program.cs.
# Connection string for local Postgres on host (adjust port if needed).

ConnectionStrings__Database=Host=127.0.0.1;Port=5434;Database=challingo;Username=scaffoldadmin;Password=changeme;Pooling=true
Jwt__Key=IYUPGgTk19+IPaQVK/4xugkHKfSF4mrPptMdzYfDI38=
Jwt__Issuer=Challingo
Jwt__Audience=Challingo-Users

Serilog__Enabled=true
Serilog__MinimumLevel=Information
Health__Enabled=true
Database__AutoMigrate=true
Maintenance__Enabled=false
Storage__Provider=Local
Storage__LocalRoot=wwwroot/uploads
Auth__OtpRateLimitPerMinute=30
Auth__SeedAdminEmail=
Auth__SeedAdminPassword=
Otp__MaxVerifyAttempts=5

RateLimit__Enabled=true
RateLimit__GlobalPerMinute=300
RequestTimeout__Enabled=true
RequestTimeout__Seconds=60
Http__Enabled=true
Http__TimeoutSeconds=15
Http__RetryCount=2
Http__RetryBaseDelayMs=200
Http__CircuitBreakFailures=5
Http__CircuitBreakSeconds=30
Idempotency__Enabled=false
Idempotency__TtlHours=24
Idempotency__HeaderName=Idempotency-Key

# OTP / sms.ir (local dev: LogOnly; production: set in deploy/api.env)
Auth__EnablePasswordLogin=true
Auth__EnableEmailAuth=true
Auth__EnablePhoneAuth=true

Otp__DevMode=true
Otp__LogOnly=true
Sms__Provider=LogOnly
Sms__SmsIrApiKey=
Sms__SmsIrVerifyTemplateId=
Sms__SmsIrVerifyCodeParameterName=CODE
# Sms__SmsIrLineNumber=
# Sms__OtpMessageTemplate=کد ورود Challingo: {code}

RabbitMq__Enabled=false
RabbitMq__HostName=127.0.0.1
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__EmailQueueName=challingo.email.outbound
RabbitMq__SmsOtpQueueName=challingo.otp.sms

# --- Redis (leaderboards, distributed cache, SignalR backplane). Local: dev-postgres compose also starts Redis on 6379.
# Off = in-memory fallbacks (single process; Worker cannot push to app clients).
Redis__Enabled=false
Redis__ConnectionString=127.0.0.1:6379,abortConnect=false
Redis__InstanceName=challingo:

# --- Realtime (SignalR hub; clients connect to <api>/hubs/app?access_token=JWT)
Realtime__Enabled=true
Realtime__HubPath=/hubs/app
Realtime__EnableDetailedErrors=true

Email__Enabled=false
Email__FromAddress=
Email__FromDisplayName=Challingo
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=

# Google Sign-In — Web OAuth client ID (comma-separated if you add Android/iOS IDs too)
Google__ClientId=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# --- Worker host (dotnet run --project Challingo.Worker) ---
Worker__PollIntervalSeconds=300
Worker__EnableSampleJob=false
Worker__EnableEmailDelivery=false
Worker__EnableSmsOtpDelivery=false

# --- Worker scheduler (Quartz cron, UTC; Scheduler__Jobs__<Name>__Enabled / __Cron per job)
Scheduler__Enabled=true
Scheduler__Jobs__Heartbeat__Enabled=false
Scheduler__Jobs__Heartbeat__Cron=0 0/5 * * * ?
