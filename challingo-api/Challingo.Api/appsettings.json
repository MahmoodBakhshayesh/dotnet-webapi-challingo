  "Serilog": {
    "Enabled": true,
    "MinimumLevel": "Information",
    "WriteToFile": false,
    "FilePath": "logs/api-.log"
  },
  "Health": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": false
  },
  "Maintenance": {
    "Enabled": false,
    "Message": "Service is temporarily unavailable for maintenance."
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "wwwroot/uploads"
  },
  "Observability": {
    "Enabled": false
  },
  "Otp": {
    "DevMode": true,
    "LogOnly": true,
    "MaxVerifyAttempts": 5
  },
  "Sms": {
    "Provider": "LogOnly",
    "SmsIrApiKey": "",
    "SmsIrLineNumber": null,
    "SmsIrVerifyTemplateId": null,
    "SmsIrVerifyCodeParameterName": "CODE",
    "OtpMessageTemplate": "کد ورود Challingo: {code}"
  },
  "Auth": {
    "EnablePasswordLogin": true,
    "EnableEmailAuth": true,
    "EnablePhoneAuth": true,
    "OtpRateLimitPerMinute": 10
  },
  "RateLimit": {
    "Enabled": true,
    "GlobalPerMinute": 120
  },
  "RequestTimeout": {
    "Enabled": true,
    "Seconds": 30
  },
  "Http": {
    "Enabled": true,
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "RetryBaseDelayMs": 200,
    "CircuitBreakFailures": 5,
    "CircuitBreakSeconds": 30
  },
  "Idempotency": {
    "Enabled": false,
    "TtlHours": 24,
    "HeaderName": "Idempotency-Key",
    "MaxBodyBytes": 1048576
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "127.0.0.1",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "EmailQueueName": "projectname.email.outbound",
    "SmsOtpQueueName": "projectname.otp.sms",
    "EmailDeadLetterQueueName": "projectname.email.deadletter",
    "SmsOtpDeadLetterQueueName": "projectname.otp.sms.deadletter"
  },
  "Competition": {
    "FreeRankedRunsPerDay": 3,
    "SmallRoundThreshold": 50,
    "ScheduleHoursAhead": 30,
    "GrandDaysAhead": 8,
    "GrandGames": 6,
    "InviteBaseUrl": "https://challingo.app/g/",
    "AllowAdminTimeTravel": false,
    "RankedDifficulty": 2,
    "GrandDifficulty": 2,
    "LotteryPot": 1000
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "127.0.0.1:6379,abortConnect=false",
    "InstanceName": "projectname:"
  },
  "Realtime": {
    "Enabled": true,
    "HubPath": "/hubs/app",
    "KeepAliveSeconds": 15,
    "ClientTimeoutSeconds": 30,
    "EnableDetailedErrors": false
  },
  "Email": {
    "Enabled": false,
    "FromAddress": "",
    "FromDisplayName": "Challingo",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "OtpSubject": "Your Challingo sign-in code",
    "OtpHtmlTemplate": "<p>Your sign-in code is <strong>{code}</strong>. It expires in 5 minutes.</p>"
  }
