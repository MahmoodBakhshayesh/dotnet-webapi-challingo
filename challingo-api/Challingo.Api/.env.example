# Copy to .env for local dev (DotNetEnv). See Program.cs in this project.

ConnectionStrings__Database=Host=127.0.0.1;Port=5434;Database=challingo;Username=scaffoldadmin;Password=changeme;Pooling=true
Jwt__Key=change-me-use-at-least-32-characters-long-secret

Auth__EnablePasswordLogin=true
Auth__EnableEmailAuth=true
Auth__EnablePhoneAuth=true

Otp__DevMode=true
Otp__LogOnly=true
Sms__Provider=LogOnly
Sms__SmsIrApiKey=
Sms__SmsIrVerifyTemplateId=
Sms__SmsIrVerifyCodeParameterName=CODE

RabbitMq__Enabled=false
RabbitMq__HostName=127.0.0.1
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__EmailQueueName=challingo.email.outbound
RabbitMq__SmsOtpQueueName=challingo.otp.sms

# --- Redis (leaderboards, distributed cache, SignalR backplane). Local: dev-postgres compose also starts Redis on 6379.
# Off = in-memory fallbacks (single process; Worker cannot push to app clients).
Redis__Enabled=false
Redis__ConnectionString=127.0.0.1:6379,abortConnect=false
Redis__InstanceName=challingo:

# --- Realtime (SignalR hub; clients connect to <api>/hubs/app?access_token=JWT)
Realtime__Enabled=true
Realtime__HubPath=/hubs/app
Realtime__EnableDetailedErrors=true

Email__Enabled=false
Email__FromAddress=
Email__FromDisplayName=Challingo
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
